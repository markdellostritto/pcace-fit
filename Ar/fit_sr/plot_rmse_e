# constants
w=2
s=1000
# plot settings
set logscale xy
set xlabel 'Epoch' font ',14'
set ylabel 'RMSE - Energy (meV/atom)' font ',14'
set xtics font ',12'
set ytics font ',12'
set grid xtics ytics mxtics mytics lw 0.75*w
set key font ',14'
# plot
plot [:] [1e-1:]\
	'train_e_rmse.dat' using ($1*s) with lines lw w lc 'red' title 'train',\
	'val_e_rmse.dat' using ($1*s) with lines lw w lc 'blue' title 'val'
pause -1 'continue'
