# constants
fname='pcace_force.dat'
w=1.5
p=1.0
s=1000.0
# plot settings
set logscale y
set xtics font ',12'
set ytics font ',12'
set xlabel 'Structure' font ',14'
set ylabel 'Error - Total Force (eV/Å)' font ',14'
set grid xtics ytics lw 1.5
set key font ',14'
# plot
plot [:] [0.1:]\
	fname using (abs($2-$3)*s) with linespoints lw w ps p lc 'black' title ''
pause -1 'continue'
