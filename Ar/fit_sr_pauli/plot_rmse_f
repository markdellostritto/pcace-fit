# constants
w=2
s=1
# plot settings
set logscale xy
set xlabel 'Epoch' font ',14'
set ylabel 'RMSE - Total Force (eV/Å)' font ',14'
set xtics font ',12'
set ytics font ',12'
set grid xtics ytics mxtics mytics lw 0.75*w
set key font ',14'
# plot
plot\
	'train_f_rmse.dat' using ($1*s) with lines lw w lc 'red' title 'train',\
	'val_f_rmse.dat' using ($1*s) with lines lw w lc 'blue' title 'val'
pause -1 'continue'
